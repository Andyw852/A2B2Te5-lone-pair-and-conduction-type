ENCUT    = 360
LASPH    = .TRUE.
LREAL    = .FALSE.
ALGO     = Normal
EDIFF    = 1E-7
NELM     = 200
ISMEAR   = 0
SIGMA    = 0.05
ISPIN    = 1
IBRION   = 2
ISIF     = 3
NSW      = 200
EDIFFG   = -0.005
KSPACING = 0.15
KGAMMA   = .TRUE.
LWAVE    = .FALSE.
LCHARG   = .FALSE.
NCORE    = 4
