# 缺陷弛豫：母胞弛豫后晶格固定，只优化原子（文献同口径）。NELECT 仅在带电态写入。
SYSTEM  = {name} defect relax
GGA     = PE
IVDW    = 12
PREC    = Accurate
ENCUT   = 360
LASPH   = .TRUE.
LREAL   = Auto
ALGO    = Normal
EDIFF   = 1E-6
NELM    = 200
ISMEAR  = 0
SIGMA   = 0.05
ISPIN   = {ispin}
ISYM    = 0
IBRION  = 2
ISIF    = 2
NSW     = 300
EDIFFG  = -0.02
LWAVE   = .FALSE.
LCHARG  = .FALSE.
NCORE   = 4
KPAR    = 2
{nelect}
